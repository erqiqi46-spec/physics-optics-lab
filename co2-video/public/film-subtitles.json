[
  {
    "start": 0.8647496666666667,
    "end": 4.8070406666666665,
    "text": "一瓶看不见的气体，怎样检验它是不是二氧化碳？",
    "shotId": "opening"
  },
  {
    "start": 5.357999666666666,
    "end": 7.725790666666667,
    "text": "又怎样判断，已经收集满了？",
    "shotId": "opening"
  },
  {
    "start": 8.266666666666667,
    "end": 9.696957666666668,
    "text": "这里是智用实验室。",
    "shotId": "opening"
  },
  {
    "start": 11.731416333333335,
    "end": 13.005457333333334,
    "text": "先检查气密性。",
    "shotId": "airtightness"
  },
  {
    "start": 13.556416333333335,
    "end": 15.311207333333336,
    "text": "注意看长颈漏斗里的液柱。",
    "shotId": "airtightness"
  },
  {
    "start": 15.864083333333333,
    "end": 20.407374333333337,
    "text": "在本次检查条件下，液柱维持，说明没有发现明显漏气。",
    "shotId": "airtightness"
  },
  {
    "start": 20.960249333333337,
    "end": 23.736707333333335,
    "text": "产生气泡，不能代替气密性检查。",
    "shotId": "airtightness"
  },
  {
    "start": 25.764749666666663,
    "end": 27.699832666666666,
    "text": "排出检查水，打开气路。",
    "shotId": "reagents"
  },
  {
    "start": 28.250791666666665,
    "end": 33.08254066666667,
    "text": "先装入大理石，复装密封，再经长颈漏斗加入稀盐酸。",
    "shotId": "reagents"
  },
  {
    "start": 33.623416666666664,
    "end": 36.54408266666667,
    "text": "漏斗下端浸入反应液，形成液封。",
    "shotId": "reagents"
  },
  {
    "start": 38.56474966666667,
    "end": 41.016666666666666,
    "text": "注意看，固体表面的气泡出现了。",
    "shotId": "bubbles"
  },
  {
    "start": 41.55562466666667,
    "end": 44.76474866666667,
    "text": "大理石中的碳酸钙，与盐酸反应放出气体。",
    "shotId": "bubbles"
  },
  {
    "start": 45.31762466666667,
    "end": 47.637374666666666,
    "text": "刚开始导出的气体还含空气。",
    "shotId": "bubbles"
  },
  {
    "start": 48.190207666666666,
    "end": 51.01474966666667,
    "text": "仅凭冒泡，不能确认二氧化碳的身份。",
    "shotId": "bubbles"
  },
  {
    "start": 53.03141633333333,
    "end": 55.29099933333333,
    "text": "把气体通入新鲜的澄清石灰水。",
    "shotId": "limewater"
  },
  {
    "start": 55.841999333333334,
    "end": 59.84441633333333,
    "text": "注意看，透明的液体逐渐变白、变浑浊。",
    "shotId": "limewater"
  },
  {
    "start": 60.39729133333333,
    "end": 65.16891633333333,
    "text": "这是生成了白色碳酸钙沉淀，是本实验检验二氧化碳的证据。",
    "shotId": "limewater"
  },
  {
    "start": 65.72179133333333,
    "end": 69.59199933333333,
    "text": "过量通气还可能使浑浊消失，要看完整过程。",
    "shotId": "limewater"
  },
  {
    "start": 71.63141633333333,
    "end": 73.69870833333333,
    "text": "二氧化碳的密度比空气大。",
    "shotId": "collection"
  },
  {
    "start": 74.23766633333334,
    "end": 78.69679033333333,
    "text": "集气瓶口朝上，导管接近瓶底，让空气从瓶口排出。",
    "shotId": "collection"
  },
  {
    "start": 79.24966633333334,
    "end": 84.41795733333333,
    "text": "彩色点只是气体分布的教学辅助示意，二氧化碳本身没有颜色。",
    "shotId": "collection"
  },
  {
    "start": 86.43141633333333,
    "end": 87.30883233333333,
    "text": "怎样验满？",
    "shotId": "fullness"
  },
  {
    "start": 87.84774933333333,
    "end": 89.42229133333333,
    "text": "把燃着木条放在瓶口。",
    "shotId": "fullness"
  },
  {
    "start": 89.97516633333333,
    "end": 92.81170733333333,
    "text": "仍然燃烧，就继续规范收集后再测。",
    "shotId": "fullness"
  },
  {
    "start": 93.35258333333333,
    "end": 96.18908233333333,
    "text": "木条熄灭，才出现本次验满现象。",
    "shotId": "fullness"
  },
  {
    "start": 96.74199933333333,
    "end": 100.52804133333333,
    "text": "这不等于百分之百纯气体，也不能唯一确定气体身份。",
    "shotId": "fullness"
  },
  {
    "start": 102.53141633333334,
    "end": 104.02183333333333,
    "text": "这个操作很容易错。",
    "shotId": "inside_error"
  },
  {
    "start": 104.56074933333333,
    "end": 106.51987433333333,
    "text": "木条伸入瓶内，已经熄灭；",
    "shotId": "inside_error"
  },
  {
    "start": 106.83237433333333,
    "end": 110.01745833333334,
    "text": "同一模型时刻，放到瓶口却仍能燃烧。",
    "shotId": "inside_error"
  },
  {
    "start": 110.57033333333334,
    "end": 113.32274933333333,
    "text": "瓶内局部积聚，不等于已经收集满。",
    "shotId": "inside_error"
  },
  {
    "start": 115.33141633333334,
    "end": 120.57179133333334,
    "text": "如果漏斗下端没有浸入液体，反应仍可能冒泡，但气体会从",
    "shotId": "funnel_error"
  },
  {
    "start": 120.59583333333333,
    "end": 122.63912433333333,
    "text": "漏斗逸出，收集效果变差。",
    "shotId": "funnel_error"
  },
  {
    "start": 123.19008333333333,
    "end": 128.03383233333332,
    "text": "注意，漏斗需要液封，发生器出气管下端则应露出液面。",
    "shotId": "funnel_error"
  },
  {
    "start": 130.06474966666667,
    "end": 132.10804166666668,
    "text": "移开导管，盖好玻璃片。",
    "shotId": "records"
  },
  {
    "start": 132.65895766666668,
    "end": 137.61087466666666,
    "text": "记下两组证据：石灰水用于检验身份，瓶口木条用于验满。",
    "shotId": "records"
  },
  {
    "start": 139.63141633333336,
    "end": 141.26604133333336,
    "text": "先检查，再加药。",
    "shotId": "summary"
  },
  {
    "start": 141.80495833333336,
    "end": 143.95641633333335,
    "text": "看清现象，再作结论。",
    "shotId": "summary"
  },
  {
    "start": 144.50929133333335,
    "end": 149.18479133333335,
    "text": "这是理想化教学模型，不能把仿真时间、气体分布，当作",
    "shotId": "summary"
  },
  {
    "start": 149.20883333333336,
    "end": 150.24245733333336,
    "text": "真实测量数据。",
    "shotId": "summary"
  },
  {
    "start": 152.2647496666667,
    "end": 154.7887486666667,
    "text": "智用实验室，让知识真正动起来。",
    "shotId": "outro"
  },
  {
    "start": 155.3157076666667,
    "end": 157.92387466666668,
    "text": "真实实验，请在教师指导下进行。",
    "shotId": "outro"
  }
]